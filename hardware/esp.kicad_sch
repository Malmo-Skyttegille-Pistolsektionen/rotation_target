	(text "GPIO0 - Boot mode\nGPIO46 - Boot mode\nGPIO35-37 - Internal flash/PSRAM\nGPIO45 - VDD_SPI for flash/PSRAM\nGPIO3 - JTAG signal source selection\n\nNormal GPIOs\n1-2\n4-7\n8      - I2C SDA (convention)\n9      - I2C SCL (convention)\n10-18\n19-20  - USB\n21\n33-34\n38-42\n43-44 UART (43-TX, 44-RX)\n47-48\n\n45 - Internal pull down\n46 - Internal pull down"
		(exclude_from_sim no)
