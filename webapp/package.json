{
  "name": "rotation_target_frontend_webapp",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": "26.9.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:pages-editor": "vite --config vite.editor.config.ts",
    "build": "tsc -b && vite build",
    "build:pages-editor": "vite build --config vite.editor.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:api": "openapi-typescript ../contracts/openapi.yaml -o src/api/generated.d.ts",
    "format": "prettier --write .",
    "e2e": "playwright test",
    "e2e:local": "e2e/run-local.sh",
    "zip": "ts-node --esm scripts/zip-dist.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-router": "1.170.38",
    "@tanstack/router-core": "1.171.32",
    "clsx": "2.1.1",
    "csstype": "3.2.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@babel/core": "8.0.6",
    "@eslint-react/eslint-plugin": "5.19.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@tanstack/router-devtools": "1.167.2",
    "@tanstack/router-plugin": "1.168.40",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "25.9.7",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "ajv": "8.20.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "happy-dom": "20.14.5",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.8",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "yaml": "2.9.1"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
