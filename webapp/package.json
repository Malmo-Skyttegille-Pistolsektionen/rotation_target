{
  "name": "rotation_target_frontend_webapp",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": "v26.7.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:api": "openapi-typescript ../contracts/openapi.yaml -o src/api/generated.d.ts",
    "format": "prettier --write .",
    "e2e": "playwright test",
    "e2e:local": "e2e/run-local.sh",
    "zip": "ts-node --esm scripts/zip-dist.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.31",
    "@tanstack/router-core": "1.171.26",
    "clsx": "2.1.1",
    "csstype": "3.2.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@tanstack/router-devtools": "1.167.1",
    "@tanstack/router-plugin": "1.168.34",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.9.5",
    "@types/prismjs": "1.26.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "ajv": "8.20.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "happy-dom": "20.11.6",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "prismjs": "1.30.0",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.11",
    "yaml": "2.9.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
